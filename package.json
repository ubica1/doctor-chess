{
  "name": "doctor-chess",
  "version": "1.5.0",
  "private": true,
  "description": "Doctor Chess — online chess, DJ Doctor, analysis and a community of players.",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "start": "python doctor-chess-site/server.py",
    "test": "node scripts/check.cjs",
    "format": "prettier --write . && python -m black doctor-chess-site",
    "format:check": "prettier --check . && python -m black --check doctor-chess-site"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://doctor-chess.ru",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubica1/doctor-chess.git"
  },
  "bugs": {
    "url": "https://github.com/ubica1/doctor-chess/issues"
  }
}
